# ─── llama-server (auto-managed by app.py) ───────────────────────────────────
# Full path to your llama-server.exe
# app.py will start this automatically when generating text,
# and shut it down after each generation to free VRAM.
# If this exe is already running when you start app.py, the program will exit with an error.
LLAMA_SERVER_EXE=D:/path/to/llama-server.exe

# Full path to the Qwen GGUF model file
QWEN_GGUF_MODEL=D:/path/to/qwen3.6-27b-q4_k_m.gguf

# llama-server network settings
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Context size (tokens) — 128K for Qwen 3.6
LLAMA_CTX_SIZE=131072

# Speculative decoding
LLAMA_SPEC_TYPE=ngram-mod
LLAMA_SPEC_NGRAM_SIZE_N=12
LLAMA_SPEC_NGRAM_SIZE_M=48

# KV cache flags
LLAMA_KV_UNIFIED=true
LLAMA_KV_OFFLOAD=true

# Memory flags
LLAMA_MLOCK=true
LLAMA_NO_MMAP=true

# Flash attention — set to "on" if your build requires "-fa on"
# Leave empty to disable
LLAMA_FLASH_ATTN=on

# Optional extra arguments passed to llama-server (space-separated)
# Example: --threads 8
LLAMA_EXTRA_ARGS=

# Multimodal projection model (optional).
# If set, --mmproj <path> is added to the llama-server command.
# Required for image-upload feature (user can attach a photo to their message).
LLAMA_MMPROJ_MODEL=D:/path/to/mmproj-BF16.gguf

# ─── OpenAI-compatible client settings ───────────────────────────────────────
# These are derived from LLAMA_HOST/PORT above; override only if needed
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=llama-cpp-local
OPENAI_MODEL=qwen3.6-35b

# Note: temperature and max_tokens are intentionally NOT passed to the local llama-server.
# Passing them can cause empty responses with some llama.cpp builds.
# Control story length via the prompt template (story_user_template.txt) instead.

# Rating tag injected into character and background prompts.
# Allowed values: general | sensitive | questionable | explicit
PROMPT_RATING=general

# ─── SDXL (Diffusers, loaded in-process) ─────────────────────────────────────
# Path to your SDXL .safetensors model file
SDXL_MODEL_PATH=D:/path/to/IL-Gembyte_20Emerald.safetensors

# Torch dtype: bfloat16 (recommended), float16, float32
SDXL_DTYPE=bfloat16

# Max images per batch for SDXL (up to 4 can run simultaneously on most GPUs)
SDXL_MAX_BATCH_SIZE=4

# Generation parameters
SDXL_STEPS=30
SDXL_GUIDANCE_SCALE=6.0

# Fixed negative prompt for all SDXL generations
SDXL_NEGATIVE_PROMPT=worst quality, comic, multiple views, bad quality, low quality, lowres, displeasing, very displeasing, bad anatomy, bad hands, scan artifacts, monochrome, greyscale, twitter username, jpeg artifacts, 2koma, 4koma, extra digits, fewer digits, jaggy lines, unclear, signature

# Character portrait resolution (vertical, 3:4 ratio)
SDXL_CHARACTER_WIDTH=768
SDXL_CHARACTER_HEIGHT=1024

# Background scene resolution (horizontal)
SDXL_BACKGROUND_WIDTH=1920
SDXL_BACKGROUND_HEIGHT=1280

# ─── Qwen Edit (stable_diffusion_cpp, loaded in-process) ─────────────────────
# Used for recurring characters (img2img consistency)
QWEN_EDIT_DIFFUSION_MODEL_PATH=D:/path/to/Qwen-Rapid-NSFW-v23_Q4_K.gguf
QWEN_EDIT_LLM_PATH=D:/path/to/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
QWEN_EDIT_VAE_PATH=D:/path/to/qwen_image_vae.safetensors
QWEN_EDIT_CLIP_VISION_PATH=D:/path/to/Qwen2.5-VL-7B-Instruct-mmproj-BF16.gguf

# Output resolution for Qwen Edit (should match character size)
QWEN_EDIT_WIDTH=768
QWEN_EDIT_HEIGHT=1024

# Generation parameters
QWEN_EDIT_CFG_SCALE=1
QWEN_EDIT_SAMPLE_STEPS=8
QWEN_EDIT_SAMPLE_METHOD=euler_a
QWEN_EDIT_SCHEDULER=simple
QWEN_EDIT_SEED=-1

# ─── Image Generation Mode ───────────────────────────────────────────────────
# sdxl_only = all characters and backgrounds use SDXL only (Qwen Edit never loaded)
# hybrid    = first-time characters use SDXL; recurring characters use Qwen Edit
# Leave empty to fall back to SD_ENABLE_CHARACTER_IMG2IMG below
IMAGE_GENERATION_MODE=sdxl_only

# Legacy flag (used only when IMAGE_GENERATION_MODE is not set)
# SD_ENABLE_CHARACTER_IMG2IMG=true

# ─── Story Generation ─────────────────────────────────────────────────────────
# How many recent segments to include as context when calling Qwen
STORY_CONTEXT_SEGMENTS=6

# ─── WebUI Ports ─────────────────────────────────────────────────────────────
MOBILE_PORT=5001
DESKTOP_PORT=5002