# ─── llama-server (auto-managed by app.py) ───────────────────────────────────
# Full path to your llama-server.exe
# app.py will start this automatically when generating text,
# and shut it down after each generation to free VRAM.
# If this exe is already running when you start app.py, the program will exit with an error.
LLAMA_SERVER_EXE=D:/path/to/llama-server.exe

# Full path to the Qwen GGUF model file
QWEN_GGUF_MODEL=D:/path/to/qwen3.6-27b-q4_k_m.gguf

# llama-server network settings
LLAMA_HOST=127.0.0.1
LLAMA_PORT=8080

# Context size (tokens) — 128K for Qwen 3.6
LLAMA_CTX_SIZE=131072

# Speculative decoding
LLAMA_SPEC_TYPE=ngram-mod
LLAMA_SPEC_NGRAM_SIZE_N=12
LLAMA_SPEC_NGRAM_SIZE_M=48

# KV cache flags
LLAMA_KV_UNIFIED=true
LLAMA_KV_OFFLOAD=true

# Memory flags
LLAMA_MLOCK=true
LLAMA_NO_MMAP=true

# Flash attention — set to "on" if your build requires "-fa on"
# Leave empty to disable
LLAMA_FLASH_ATTN=on

# Optional extra arguments passed to llama-server (space-separated)
# Example: --threads 8
LLAMA_EXTRA_ARGS=

# Multimodal projection model (optional).
# If set, --mmproj <path> is added to the llama-server command.
# Required for image-upload feature (user can attach a photo to their message).
LLAMA_MMPROJ_MODEL=D:/path/to/mmproj-BF16.gguf

# ─── OpenAI-compatible client settings ───────────────────────────────────────
# These are derived from LLAMA_HOST/PORT above; override only if needed
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
OPENAI_API_KEY=llama-cpp-local
OPENAI_MODEL=qwen3.6-35b

# Note: temperature and max_tokens are intentionally NOT passed to the local llama-server.
# Passing them can cause empty responses with some llama.cpp builds.
# Control story length via the prompt template (story_user_template.txt) instead.

# Rating tag injected into character and background prompts.
# Allowed values: general | sensitive | questionable | explicit
PROMPT_RATING=general

# ─── SDXL (Diffusers, loaded in-process) ─────────────────────────────────────
# Path to your SDXL .safetensors model file
SDXL_MODEL_PATH=D:/path/to/IL-Gembyte_20Emerald.safetensors

# Torch dtype: bfloat16 (recommended), float16, float32
SDXL_DTYPE=bfloat16

# Max images per batch for SDXL (up to 4 can run simultaneously on most GPUs)
SDXL_MAX_BATCH_SIZE=4

# Generation parameters
SDXL_STEPS=30
SDXL_GUIDANCE_SCALE=6.0

# Fixed negative prompt for all SDXL generations
SDXL_NEGATIVE_PROMPT=worst quality, comic, multiple views, bad quality, low quality, lowres, displeasing, very displeasing, bad anatomy, bad hands, scan artifacts, monochrome, greyscale, twitter username, jpeg artifacts, 2koma, 4koma, extra digits, fewer digits, jaggy lines, unclear, signature
QWEN_EDIT_NEGATIVE_PROMPT=deformed, mutated, disfigured, poorly drawn hands, poorly drawn face, extra limbs, extra fingers, extra arms, extra legs, malformed limbs, fused fingers, too many fingers, long neck, missing arms, missing legs, bad anatomy, bad proportions, cloned face, gross proportions, text, error, cropped, worst quality, low quality, jpeg artifacts, signature, watermark, username, blurry

# Character portrait resolution (vertical, 3:4 ratio)
SDXL_CHARACTER_WIDTH=768
SDXL_CHARACTER_HEIGHT=1024

# Background scene resolution (horizontal)
SDXL_BACKGROUND_WIDTH=1920
SDXL_BACKGROUND_HEIGHT=1280

# ─── Qwen Edit (stable_diffusion_cpp, loaded in-process) ─────────────────────
# Used for recurring characters (img2img consistency)
QWEN_EDIT_DIFFUSION_MODEL_PATH=D:/path/to/Qwen-Rapid-NSFW-v23_Q4_K.gguf
QWEN_EDIT_LLM_PATH=D:/path/to/Qwen2.5-VL-7B-Instruct-Q4_K_M.gguf
QWEN_EDIT_VAE_PATH=D:/path/to/qwen_image_vae.safetensors
QWEN_EDIT_CLIP_VISION_PATH=D:/path/to/Qwen2.5-VL-7B-Instruct-mmproj-BF16.gguf
QWEN_EDIT_F2P_LORA_PATH=D:/path/to/LORA

# Output resolution for Qwen Edit (should match character size)
QWEN_EDIT_WIDTH=768
QWEN_EDIT_HEIGHT=1024

# Generation parameters
QWEN_EDIT_CFG_SCALE=1
QWEN_EDIT_SAMPLE_STEPS=8
QWEN_EDIT_SAMPLE_METHOD=euler_a
QWEN_EDIT_SCHEDULER=simple
QWEN_EDIT_SEED=-1

# ─── ZImage (Diffusers, serial generation) ───────────────────────────────────
# Used when IMAGE_GENERATION_MODE=zimage_hybrid
# ZImage generates images one at a time (no batching).
# Resolution is shared with SDXL (SDXL_CHARACTER_WIDTH/HEIGHT, SDXL_BACKGROUND_WIDTH/HEIGHT).
ZIMAGE_MODEL_PATH=D:/path/to/Z-Image-Turbo
ZIMAGE_DTYPE=bfloat16
ZIMAGE_STEPS=9
# Turbo models require guidance_scale=0.0
ZIMAGE_GUIDANCE_SCALE=0.0
# Attention backend: "flash" (Flash-Attention-2) or "_flash_3" (Flash-Attention-3)
ZIMAGE_ATTENTION_BACKEND=flash
# Whether to call pipe.enable_model_cpu_offload() (true/false)
ZIMAGE_ENABLE_CPU_OFFLOAD=true
# Negative prompt for ZImage (realistic/photographic style)
ZIMAGE_NEGATIVE_PROMPT=extra limbs, extra fingers, extra arms, extra legs, blurry skin texture, plastic skin, waxy face, oversaturated colors, flat lighting, low contrast, dull skin tone
# ZImage execution mode:
#   subprocess = ZImage runs in a child process (recommended).
#                When the child exits, the OS reclaims all CPU RAM and CUDA memory,
#                so Qwen Edit is not slowed down by ZImage memory residue.
#   inprocess  = ZImage runs inside app.py (may leave CPU RAM residue after generation).
#                Use only for debugging.
ZIMAGE_RUN_MODE=subprocess

# ─── Image Generation Mode ───────────────────────────────────────────────────
# sdxl_only    = SDXL for all images; Qwen Edit only for uploaded-image-bound characters
#                Prompt template: story_user_template.txt (English Danbooru tag-style)
# sdxl_hybrid  = SDXL for new characters/backgrounds; Qwen Edit for recurring characters
#                Prompt template: story_user_template.txt (English Danbooru tag-style)
# zimage_hybrid= ZImage for new characters/backgrounds; Qwen Edit for recurring characters
#                Prompt template: story_user_template_zimage.txt (Chinese natural language)
IMAGE_GENERATION_MODE=sdxl_only

# Legacy flag (used only when IMAGE_GENERATION_MODE is not set)
# SD_ENABLE_CHARACTER_IMG2IMG=true

# ─── Language & Feature Flags ─────────────────────────────────────────────────
# UI language: controls WebUI button labels and status messages.
# 界面语言：控制 WebUI 按钮标签和状态消息。
# Accepted values / 可选值: zh-CN | en-US
UI_LANGUAGE=zh-CN

# Story language: controls the language of LLM-generated story JSON (text, prompts).
# 故事语言：控制 LLM 生成的故事 JSON 的语言（正文、提示词）。
# If not set, defaults to UI_LANGUAGE. / 未设置时默认与 UI_LANGUAGE 相同。
# Accepted values / 可选值: zh-CN | en-US
STORY_LANGUAGE=zh-CN

# Whether to generate background images.
# 是否生成背景图。
# Set to false to skip background generation regardless of IMAGE_GENERATION_MODE.
# 设为 false 时，无论 IMAGE_GENERATION_MODE 如何，都不生成背景图。
ENABLE_BACKGROUND_GENERATION=true

# ─── Story Context ────────────────────────────────────────────────────────────
# LLAMA_CTX_SIZE: maximum context window for llama-server (tokens).
# STORY_CONTEXT_SEGMENTS: how many recent story segments to inject per LLM prompt.
# 128K context does NOT mean every request uses 128K — actual usage is controlled by
# STORY_CONTEXT_SEGMENTS. Recommended: 24 for most use cases.
# LLAMA_CTX_SIZE：llama-server 最大上下文（token 数）。
# STORY_CONTEXT_SEGMENTS：每次注入 LLM prompt 的最近故事段数，推荐 24。
# (LLAMA_CTX_SIZE is already set above in the llama-server section)
STORY_CONTEXT_SEGMENTS=24

# ─── Story Backup ─────────────────────────────────────────────────────────────
# Atomic write + timestamped backup for story.json.
# story.json 原子写入 + 时间戳备份。
# STORY_BACKUP_ENABLED: set to false to disable backups.
# STORY_BACKUP_KEEP: number of backup files to keep (oldest are pruned).
STORY_BACKUP_ENABLED=true
STORY_BACKUP_KEEP=20

# ─── LLM JSON Repair ──────────────────────────────────────────────────────────
# When the LLM returns malformed JSON, automatically send it back for repair.
# Does NOT affect normal successful JSON output — only triggered on parse failure.
# LLM 返回格式错误的 JSON 时，自动发回修复，不影响正常成功输出。
# LLM_JSON_REPAIR_MAX_CHARS: max chars sent to repair LLM (head+tail truncation).
ENABLE_LLM_JSON_REPAIR=true
LLM_JSON_REPAIR_MAX_CHARS=24000

# ─── Qwen Edit Reference Policy ───────────────────────────────────────────────
# Reference image policy for Qwen Edit character consistency.
# Qwen Edit 角色一致性参考图策略。
# latest = use the most recent successful character image (recommended)
#          最近参考图策略（推荐）
# first  = always use the first successful character image
#          首次参考图策略
QWEN_EDIT_REFERENCE_POLICY=latest

# Fall back to SDXL text-to-image when Qwen Edit fails.
# Qwen Edit 失败后自动用 SDXL 文生图补充。
QWEN_EDIT_FALLBACK_TO_SDXL=true

# ─── Regen Queue ──────────────────────────────────────────────────────────────
# Debounce window for image regeneration requests (milliseconds).
# Clicks within this window are merged into one batch to avoid reloading models.
# 图片重生请求合并窗口（毫秒），窗口内的点击合并为一批，避免重复加载模型。
REGEN_DEBOUNCE_MS=3000

# ─── WebUI Ports ─────────────────────────────────────────────────────────────
MOBILE_PORT=5001
DESKTOP_PORT=5002
